# ============================================================
# Common
# ============================================================
PROJECT_NAME=graphrag_agent

# ============================================================
# 서비스 설치/실행 선택 플래그 (Docker Compose Profiles)
# 실행할 서비스 프로필을 쉼표(,)로 연결하여 설정합니다.
# 제외할 서비스는 목록에서 제거하면 실행되지 않습니다.
#
# 선택 가능 프로필:
#   - neo4j    : Neo4j Graph DB (포트 7474, 7687)
#   - postgres : PostgreSQL + Apache AGE (포트 5432)
#   - mongo    : MongoDB NoSQL DB (포트 27017)
#   - ollama   : Ollama AI 추론/임베딩 서버 (포트 11434)
#   - langfuse : Langfuse LLM 관측성/트레이싱 플랫폼 (포트 3000)
#   - app      : FastAPI/Fullstack 애플리케이션
#   - all      : 모든 서비스 실행
#
# 설정 예시:
#   전체 실행    : COMPOSE_PROFILES=neo4j,postgres,mongo,ollama,app,langfuse (또는 all)
#   Neo4j만 실행 : COMPOSE_PROFILES=neo4j
#   DB류만 실행  : COMPOSE_PROFILES=neo4j,postgres,mongo
#   Ollama만 실행: COMPOSE_PROFILES=ollama
#   Langfuse 실행: COMPOSE_PROFILES=postgres,langfuse
# ============================================================
COMPOSE_PROFILES=neo4j,postgres,mongo,ollama,app,langfuse

# ============================================================
# Neo4j (Graph DB)
#  - Neo4j 5 의 NEO4J_AUTH 는 초기 사용자명으로 'neo4j' 만 허용
#  - 비밀번호는 8자 이상
# ============================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin123
NEO4J_DATABASE=db-graphrag-agent
NEO4J_URI=bolt://db_neo4j:7687

# ============================================================
# PostgreSQL + Apache AGE
# ============================================================
AGE_IMAGE_TAG=latest
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=db_graphrag_agent
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# ============================================================
# MongoDB
# ============================================================
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=db_graphrag_agent
MONGO_HOST=db_mongo
MONGO_PORT=27017

# ============================================================
# Ollama (Local LLM / Embedding)
# ============================================================
AI_OLAMA_CPU=8
LLM_MODEL=sam860/exaone-4.0:1.2b-thinking-Q8_0
EMBEDDING_MODEL=bge-m3:567m
MODEL_API_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama

# ============================================================
# Langfuse (LLM Observability & Tracing Platform)
# ============================================================
LANGFUSE_IMAGE_TAG=2
LANGFUSE_PORT=3000
LANGFUSE_DB_NAME=db_langfuse
LANGFUSE_NEXTAUTH_SECRET=7f884a1e94b29bb88a2e1d7cf9d2c2d431c172428dfabf192b0058b8772a8187
LANGFUSE_SALT=8b4c27806e57ab2702758155bb3f9ff3a216c02698971f11467be5cd8198f7df
LANGFUSE_NEXTAUTH_URL=http://localhost:3000
LANGFUSE_TELEMETRY_ENABLED=false

# Langfuse Headless Initialization (최초 구동 시 자동 프로비저닝)
LANGFUSE_INIT_ORG_ID=graphrag-org
LANGFUSE_INIT_ORG_NAME=GraphRAG Organization
LANGFUSE_INIT_PROJECT_ID=graphrag-project
LANGFUSE_INIT_PROJECT_NAME=Demon Slayer GraphRAG
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-graphrag-agent-public
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-graphrag-agent-secret
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=admin123456

# Langfuse Client SDK Connection (Application SSOT)
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-graphrag-agent-public
LANGFUSE_SECRET_KEY=sk-lf-graphrag-agent-secret

# ============================================================
# Common
# ============================================================
PROJECT_NAME=graphrag_agent

# ============================================================
# 서비스 설치/실행 선택 플래그 (Docker Compose Profiles)
# 실행할 서비스 프로필을 쉼표(,)로 연결하여 설정합니다.
# 제외할 서비스는 목록에서 제거하면 실행되지 않습니다.
#
# 선택 가능 프로필:
#   - neo4j    : Neo4j Graph DB (포트 7474, 7687)
#   - postgres : PostgreSQL + Apache AGE (포트 5432)
#   - ollama   : Ollama AI 추론/임베딩 서버 (포트 11434)
#   - app      : FastAPI/Fullstack 애플리케이션
#   - all      : 모든 서비스 실행
#
# 설정 예시:
#   전체 실행    : COMPOSE_PROFILES=neo4j,postgres,ollama,app (또는 all)
#   Neo4j만 실행 : COMPOSE_PROFILES=neo4j
#   DB류만 실행  : COMPOSE_PROFILES=neo4j,postgres
#   Ollama만 실행: COMPOSE_PROFILES=ollama
# ============================================================
COMPOSE_PROFILES=neo4j,postgres,ollama,app

# ============================================================
# Neo4j (Graph DB)
#  - Neo4j 5 의 NEO4J_AUTH 는 초기 사용자명으로 'neo4j' 만 허용
#  - 비밀번호는 8자 이상
# ============================================================
NEO4J_USER=neo4j
NEO4J_PASSWORD=admin123
NEO4J_DATABASE=db-graphrag-agent
NEO4J_URI=bolt://db_neo4j:7687

# ============================================================
# PostgreSQL + Apache AGE
# ============================================================
AGE_IMAGE_TAG=latest
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=db_graphrag_agent
POSTGRES_HOST=db_postgres
POSTGRES_PORT=5432

# ============================================================
# Ollama (Local LLM / Embedding)
# ============================================================
AI_OLAMA_CPU=8
LLM_MODEL=sam860/exaone-4.0:1.2b-thinking-Q8_0
EMBEDDING_MODEL=bge-m3:567m
MODEL_API_URL=http://ollama:11434/v1
OPENAI_API_KEY=ollama